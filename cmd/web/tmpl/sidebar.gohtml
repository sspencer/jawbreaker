{{ define "sidebar" }}
<div class="sidebar">
    <div class="score-container">
        <div class="score-box">
            <div class="score-label">Current</div>
            <div id="current-score" class="score-value" {{ if .DS }} data-text="$score" {{ end }}>0</div>
        </div>
        <div class="score-box">
            <div class="score-label">Last</div>
            <div id="last-score" class="score-value"  {{ if .DS }} data-text="$last" {{ end }}>0</div>
        </div>
        <div class="score-box">
            <div class="score-label">Best</div>
            <div id="best-score" class="score-value"  {{ if .DS }} data-text="$best" {{ end }}>0</div>
        </div>
    </div>
    <button id="restart-btn" class="btn" {{ if .DS }} data-on-click="@post('new')" {{ end }}>Restart</button>
    <button id="undo-btn" class="btn" {{ if .DS }} style="display:none" {{ end }}>Undo</button>
    <button id="help-btn" class="btn"  {{ if .DS }} data-on-click="$help=true" {{ end }}>Help</button>
    <button id="settings-btn" class="btn" {{ if .DS }} data-on-click="$settings=true" {{ end }}>Settings</button>
</div>
{{ end }}
